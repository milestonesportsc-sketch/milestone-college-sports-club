# Copy this file to ".env" and change the values. Never commit ".env".
PORT=8080
# First-run Database Administrator account (used only when the database has no users yet).
# The Club President and Editor accounts are then created by the Database Administrator inside the dashboard.
ADMIN_EMAIL=milestonesportsc@gmail.com
ADMIN_PASSWORD=
# Where the database, uploads and logs live. On a host, point this at a persistent disk.
DATA_DIR=./data
# Set to 1 when the site runs behind one proxy (Render, Fly, Nginx). Use 2 for Cloudflare + a host proxy.
TRUST_PROXY=0
# Optional: lets a monitoring tool read /api/metrics with "Authorization: Bearer <token>".
METRICS_TOKEN=
# Optional: number of worker processes (see ARCHITECTURE.md before using more than 1).
WEB_CONCURRENCY=1
# Membership fee used before an admin has saved Settings.
DEFAULT_FEE=350
# Forgot-password emails (optional). Without these, the reset link is printed in the server terminal/log.
# Security alarm emails (and the intruder photo) use the same settings.
# Gmail does NOT accept the normal account password here. Turn on 2-step verification, then create an "App password"
# (Google Account > Security > App passwords) and paste that 16-letter code as SMTP_PASS.
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=milestonesportsc@gmail.com SMTP_PASS=<16-letter app password>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# The public address of the site, used inside the reset email (no trailing slash), e.g. https://mcsc.onrender.com
PUBLIC_URL=

# Optional: a fixed secret for signing login tokens (Render generates one for you in render.yaml). Use 32+ random characters.
SECRET=
# Redirect plain-http page requests to https when behind a proxy (default on). Set 0 to switch off.
FORCE_HTTPS=1
# One automatic database backup per day (default on). Set 0 to switch off.
AUTO_BACKUP=1

# Automatic IP block after 5 wrong passwords in a row (default on). Set 0 to switch off.
AUTO_IP_BLOCK=1

# SMS security alerts (optional). A text message goes to ALERT_PHONE when somebody signs in or fails to sign in.
# SMS_URL is the "send SMS" address from your SMS provider, with {to} and {msg} where the number and text go, e.g.
#   SMS_URL=https://your-provider.example/api?key=YOUR_API_KEY&to={to}&text={msg}
# Keep this file private: it holds the phone number and the provider key. Never commit ".env".
ALERT_PHONE=01340340744
SMS_URL=
# Who triggers a text when they SIGN IN: all (default) | dba (only the Database Administrator) | off. Failed attempts always send one.
ALERT_ON_LOGIN=all
# Safety limit so wrong-password floods cannot run up the SMS bill (default 8 texts per 10 minutes).
SMS_MAX_PER_10MIN=8
